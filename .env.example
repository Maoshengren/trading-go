# Longbridge OpenAPI credentials
LONGBRIDGE_APP_KEY=
LONGBRIDGE_APP_SECRET=

# Backward-compatible fallback token.
# If the mode-specific token below is empty, the code will fall back to this value.
LONGBRIDGE_ACCESS_TOKEN=

# Account mode: paper | live
LONGBRIDGE_ACCOUNT_MODE=paper

# Recommended: configure separate tokens for paper/live and let the app pick automatically
LONGBRIDGE_ACCESS_TOKEN_PAPER=
LONGBRIDGE_ACCESS_TOKEN_LIVE=

# Optional Longbridge runtime flags
# LONGBRIDGE_ENV=staging
# LONGBRIDGE_LOG_LEVEL=info

# Binance USDⓈ-M Futures API credentials
BINANCE_FUTURES_API_KEY=
BINANCE_FUTURES_API_SECRET=
BINANCE_FUTURES_TESTNET=true
BINANCE_FUTURES_BASE_URL=

# Backward-compatible fallback names if you already used the old Binance spot envs
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_SPOT_TESTNET=
BINANCE_SPOT_BASE_URL=
BINANCE_DEFAULT_QUOTE_ASSET=USDT
